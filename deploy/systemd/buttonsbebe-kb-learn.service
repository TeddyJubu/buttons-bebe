[Unit]
Description=Buttons Bebe nightly learning (promote approved replies + reindex)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Buttonsbebe Agent/KB
ExecStart=/bin/bash "/root/Buttonsbebe Agent/KB/learn-nightly.sh"

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
