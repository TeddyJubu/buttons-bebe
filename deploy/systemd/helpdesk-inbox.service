[Unit]
Description=Buttons Bebe isolated inbox (Send locked)
After=network.target

[Service]
Type=simple
User=bb-inbox
Group=bb-inbox
WorkingDirectory=/opt/buttonsbebe/inbox
ExecStart=/opt/buttonsbebe/inbox/venv/bin/python /opt/buttonsbebe/inbox/console-src/inbox/review_server.py --host 127.0.0.1 --port 8766
Environment=HELPDESK_DB_FILE=/var/lib/buttonsbebe-inbox/inbox.sqlite3
Environment=INBOX_PROJECTION_PATH=/var/lib/buttonsbebe-inbox-projection/projection.sqlite3
Environment=SHOP_RAIL_PATH=/var/lib/buttonsbebe-inbox-projection/shop-rail.sqlite3
Environment=HELPDESK_PRODUCTION=1
# Resolves "Assigned to me" only. The operator's own address is host-local and
# stays redacted here; empty or malformed leaves that view empty.
Environment=INBOX_OPERATOR_GORGIAS_EMAIL=<REDACTED>
Environment=SHOPIFY_MUTATIONS_ENABLED=0
Environment=HELPDESK_OUTBOUND_ENABLED=0
Environment=GORGIAS_BRIDGE_ENABLED=0
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=buttonsbebe-inbox
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# This service reads local snapshots and accepts Caddy requests; it never initiates connections.
SystemCallFilter=~connect
SystemCallErrorNumber=EPERM
MemoryHigh=256M
MemoryMax=512M
TasksMax=64
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
