[Unit]
Description=Buttons Bebe Redo returns MCP tool (for Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=REDO_MCP_TRANSPORT=streamable-http
Environment=REDO_MCP_HOST=127.0.0.1
Environment=REDO_MCP_PORT=8078
ExecStart=/root/redo-mcp-run.sh
Restart=on-failure
RestartSec=3

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
