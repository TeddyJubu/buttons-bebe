[Unit]
Description=Buttons Bebe KB admin (editable knowledge base API for the console)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=KB_ADMIN_PORT=8087
Environment="KB_DIR=/root/Buttonsbebe Agent/KB"
ExecStart=/bin/bash -c 'exec /usr/local/bin/node "/root/Buttonsbebe Agent/kb-admin/server.js"'
Restart=on-failure
RestartSec=3

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
