[Unit]
Description=Buttons Bebe Job Processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Buttonsbebe Agent/processor
ExecStart=/bin/bash -c 'exec "/root/Buttonsbebe Agent/processor/.venv/bin/python" -m orchestrator'
Restart=always
RestartSec=5
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment="PYTHONPATH=/opt/buttonsbebe/shared:/root/Buttonsbebe Agent/processor:/root/Buttonsbebe Agent/webhook/src"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bb-processor

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
