[Unit]
Description=Buttons Bebe KB product sync (Shopify -> KB, then re-index)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Quoted because the path contains a space. The script fetches products,
# rebuilds the index, and restarts the KB service.
ExecStart="/root/Buttonsbebe Agent/KB/sync-products.sh"
TimeoutStartSec=1800

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
