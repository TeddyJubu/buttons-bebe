[Unit]
Description=Buttons Bebe Notice Board cleanup (drop expired notices)

[Service]
Type=oneshot
# Quoted because the path contains a space. Zero third-party deps, so the
# system python is fine (no virtualenv needed).
ExecStart=/usr/bin/python3 "/root/Buttonsbebe Agent/KB/scripts/purge_notices.py"
TimeoutStartSec=60

# Conservative restrictions compatible with the existing /root application.
# Dedicated identities and ProtectHome require a separate data/config move.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
