[Unit]
Description=Read-only Shopify details for opened support tickets
After=network-online.target helpdesk-inbox2.service
Wants=network-online.target helpdesk-inbox2.service

[Service]
Type=simple
User=root
Group=bb-inbox
WorkingDirectory=/opt/buttonsbebe/inbox2
ExecStart=/opt/buttonsbebe/inbox/venv/bin/python /opt/buttonsbebe/inbox2/shop_worker.py
Environment="SHOP_RAIL_ENV_FILE=/root/Buttonsbebe Agent/.env"
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=buttonsbebe-inbox2-shop
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/buttonsbebe-inbox2
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=16
Restart=on-failure
RestartSec=5
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
