# Support console and webhook ingress.
#
# Redacted placeholders:
#   <WA_TOKEN> is the path token configured only in the protected production
#   environment. This source file is an audit/template reference, not a
#   deployable credential bundle.

hermes.buttonsbebe.com {
	# Hermes Agent web dashboard. Authentication is enforced by Hermes.
	reverse_proxy 127.0.0.1:9119 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 300s
		}
	}

	request_body {
		max_size 16MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	encode gzip zstd
	log {
		output file /var/log/bb-webhook/caddy-hermes.log
		# Drop the complete URI: both query secrets and WhatsApp path tokens
		# are credentials. Header redaction also prevents a Referer echo.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
}

srv1766050.hstgr.cloud, support.buttonsbebe.com {
	@whatsapp path /connect-whatsapp/<WA_TOKEN> /connect-whatsapp/<WA_TOKEN>/*
	handle @whatsapp {
		reverse_proxy 127.0.0.1:8085
	}

	# Historical QA reports stay on disk, but are not a public production route.
	@retiredqa path /qa /qa/*
	handle @retiredqa {
		respond "Not found" 404
	}

	# Inbox 2 live read-only API: authenticate before forwarding to the local service.
	handle /inbox2/api/* {
		route {
			forward_auth 127.0.0.1:8000 {
				uri /auth/page-check
			}
			reverse_proxy 127.0.0.1:8767
		}
	}

	# Primary standalone live inbox.
	redir /inbox2 /inbox2/ 308
	handle /inbox2/* {
		route {
			forward_auth 127.0.0.1:8000 {
				uri /auth/page-check
			}
			uri strip_prefix /inbox2
			root * /var/www/inbox2
			header {
				Cache-Control "no-store"
				X-Robots-Tag "noindex, nofollow"
				Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.shopify.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			}
			file_server
		}
	}

	# Dedicated inbox prefix; strip it only inside this handler. Its own
	# /console/api/helpdesk must never hit the live dashboard's /console/api.
	redir /inbox /inbox/ 308
	handle /inbox/* {
		# Keep the original prefix for auth's API/page and return-path checks.
		# Explicit route ordering prevents Caddy sorting strip_prefix first.
		route {
			forward_auth 127.0.0.1:8000 {
				uri /auth/page-check
			}
			uri strip_prefix /inbox
			reverse_proxy 127.0.0.1:8766 {
				header_up -Cookie
				header_up -Authorization
			}
		}
	}

	@consoleauth path /console/api/auth/*
	handle @consoleauth {
		uri replace /console/api/auth /auth
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@consoleapi path /console/api/*
	handle @consoleapi {
		forward_auth 127.0.0.1:8000 {
			uri /auth/check
		}
		uri replace /console/api /dashboard/api
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@consolewa path /console/waapi/*
	handle @consolewa {
		forward_auth 127.0.0.1:8000 {
			uri /auth/check
		}
		uri replace /console/waapi /wa
		reverse_proxy 127.0.0.1:8085 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle_path /console/kbapi/* {
		forward_auth 127.0.0.1:8000 {
			uri /auth/check
		}
		reverse_proxy 127.0.0.1:8087 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@consolelogin path /console/login /console/login/*
	handle @consolelogin {
		root * /var/www/console
		rewrite * /login.html
		file_server
	}

	handle_path /console* {
		forward_auth 127.0.0.1:8000 {
			uri /auth/page-check
		}
		root * /var/www/console
		file_server
	}

	@roothome path /
	handle @roothome {
		redir * /console/ 302
	}

	# /dashboard/api is the FastAPI service's internal route namespace. The
	# authenticated /console/api handler above rewrites to it inside its own
	# terminal handle. Never let a public request reach these read/write routes
	# through the catch-all webhook proxy below.
	@directdashboard path /dashboard /dashboard/*
	handle @directdashboard {
		respond "Not found" 404
	}

	@publicwebhook path /webhook/gorgias/*
	handle @publicwebhook {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@health path /health /ready
	handle @health {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not found" 404
	}

	request_body {
		max_size 256KB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	encode gzip zstd
	log {
		output file /var/log/bb-webhook/caddy.log
		# Drop the complete URI: both query secrets and WhatsApp path tokens
		# are credentials. Header redaction also prevents a Referer echo.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
}
